{
  "name": "@clan-world/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./effect": "./src/effect.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.7",
    "effect": "^3.22.1",
    "@effect/sql": "^0.52.1",
    "@effect/sql-drizzle": "^0.51.0",
    "@effect/sql-pg": "^0.53.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
