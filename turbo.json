{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@clan-world/shared#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@clan-world/db#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
